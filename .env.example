# Database (Neon Serverless PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-sample-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Midtrans Payment Gateway (Sandbox)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxx"
NEXT_PUBLIC_MIDTRANS_SNAP_URL="https://app.sandbox.midtrans.com/snap/snap.js"

# WhatsApp Gateway (Fonnte API or WAHA)
WHATSAPP_GATEWAY_PROVIDER="fonnte" # "fonnte" | "waha"
WHATSAPP_API_URL="https://api.fonnte.com/send"
WHATSAPP_API_TOKEN="fonnte-api-token"

# App & Cron Security
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="your-cron-secret-token"
